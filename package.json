{
  "name": "shop-management",
  "private": true,
  "version": "1.0.0",
  "description": "Shop Management System for local shops",
  "author": "Rayyan Ahmed",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.rayyan.shopmanagement",
    "productName": "Shop Management System",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "shop-management-system-setup.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "setup.sql",
        "to": "setup.sql"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "mssql": "^12.7.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "react-toastify": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}